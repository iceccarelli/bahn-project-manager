@@ -97,6 +97,18 @@
   --color-ring: hsl(var(--ring));
 
   /* Sidebar Tokens */
+  /*
+   * --color-sidebar was missing, and that is the whole mobile drawer bug.
+   *
+   * The palette defined --color-sidebar-background, so `bg-sidebar-background`
+   * worked and nobody noticed. The shadcn sidebar paints itself with
