+/* ---------------------------------------------------------------------------
+   page-title — one size rule for every page's <h1>.
+
+   Before this there were two: text-4xl on Dashboard, BVB-EEA and PSV-ITK,
+   text-3xl on Projektanmeldung and Änderungshistorie, and none of them
+   responsive. At 375px "PSV-ITK Projektvorstellungen" at 36px pushed <main>
+   to 390px in a 375px viewport, because "Projektvorstellungen" is a single
+   unbreakable 20-character word. A shared utility rather than a repeated class
+   string: five copies of a breakpoint is how the header's md/lg drift happened.
+   --------------------------------------------------------------------------- */
+@utility page-title {
+  font-size: 1.5rem;      /* text-2xl */
+  line-height: 2rem;
+  font-weight: 700;
+  letter-spacing: -0.025em;
+  text-wrap: balance;
+  overflow-wrap: break-word;
+  hyphens: auto;
+}
+@media (min-width: 640px) {
+  .page-title { font-size: 1.875rem; line-height: 2.25rem; }  /* text-3xl */
+}
+@media (min-width: 1024px) {
+  .page-title { font-size: 2.25rem; line-height: 2.5rem; }    /* text-4xl */
+}
+
 /* The gutter widens with the viewport; because it is a custom property the
    three landmarks widen together rather than each on its own breakpoint. */
 @media (min-width: 640px) {
@@ -323,12 +349,130 @@
     min-height: 44px;
   }
 
-  /* table cells stay dense — the 44px floor is for things you tap, and a
-     tap-through row would otherwise double the height of a 1,298-row table */
+  /* Table cells stay dense — the 44px floor is for things you tap, and a
+     tap-through row would otherwise double the height of a 1,298-row table.
+
+     But "dense" and "hard to hit" are not the same requirement. The box stays
+     32px; the *hit area* does not. ::after paints a 44x44 strip centred on the
+     control, so a finger gets the WCAG 2.5.5 target while the grid keeps its
+     measured 57px row pitch: 44 centred in 57 leaves 6.5px of clearance above
+     and below, so adjacent rows never steal each other's taps. Nothing about
+     layout changes — the pseudo-element is out of flow and fully transparent.
+
+     Measured before: 7,795 controls at 32px on every touch profile from
+     iPhone SE to iPad Pro. */
   td button,
   td [role="button"],
   th button {
     min-height: 32px;
+    position: relative;
+  }
+
+  td button::after,
+  td [role="button"]::after,
+  th button::after {
+    content: "";
+    position: absolute;
+    top: 50%;
+    left: 50%;
+    transform: translate(-50%, -50%);
+    height: 44px;
+    width: 44px;
+    min-width: 100%;
+    /* hit area only — never paints, never captures the pointer for anything
+       other than its own button */
+    pointer-events: auto;
+  }
+}
+
+/* ---------------------------------------------------------------------------
+   Map chrome.
+
+   Leaflet renders its zoom control and its attribution into the map's own DOM,
+   below the React overlays — which is why an overlay probe that only walked the
+   React siblings of .leaflet-container reported "no overlap" while the app's
+   control cluster sat directly on top of Leaflet's +/- buttons. Both are
+   measured together now.
+
+   Placement switches on POINTER, not width, because the constraint is a thumb
+   and not a viewport:
+
+     fine   (mouse)  cluster top-right, Leaflet's zoom bottom-right
+     coarse (touch)  Leaflet's zoom is hidden — pinch and double-tap are the
+                     native gestures and every mobile map app drops the +/-
+                     buttons — and the cluster takes the bottom-right corner,
+                     which is the one corner a thumb reaches on an 852px phone.
+
+   Everything clears the attribution line, which Leaflet parks bottom-right and
+   which is 17px tall.
+   --------------------------------------------------------------------------- */
+/* On :root, not on .leaflet-container. The three overlays are SIBLINGS of the
+   Leaflet container, so a variable scoped to it does not reach them — and an
+   unresolvable var() makes `top`/`left` invalid at computed-value time, which
+   silently drops an absolutely positioned card back to its static position at
