# ============================================
# BAHN PROJECT MANAGER v2.0 — COMPLETE ENV
# Copy to .env and fill values
# ============================================

# Database (MySQL for now — migrate to Postgres/Neon for full-text search)
DATABASE_URL="mysql://user:password@host:3306/bahn_project_manager"

# Redis (for bulletproof caching — use Upstash free tier or local)
REDIS_URL="redis://localhost:6379"          # or "rediss://user:pass@upstash.io:6379"

# Microsoft Entra ID sign-in (production). The browser is a public SPA client (authorization code + PKCE): there is NO
# client secret anywhere in this application. The server only validates access tokens. Exact values: docs/auth.md,
# docs/entra-acceptance.md. v1 and v2 spellings may both be listed (comma separated).
OIDC_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"      # server: token issuer(s)
OIDC_AUDIENCE="<api-application-client-id>"                           # server: token audience(s)
VITE_OIDC_AUTHORITY="https://login.microsoftonline.com/<tenant-id>/v2.0"   # build-time, public
VITE_OIDC_CLIENT_ID="<spa-application-client-id>"                          # build-time, public
VITE_OIDC_SCOPE="openid profile api://<api-application-client-id>/access_as_user"

# App
NODE_ENV="development"          # production | development
PORT=3000

# Ersatzquelle fuer die Projektdaten, falls /data.json im Deploy fehlt.
# Leer lassen heisst: keine zweite Quelle. Frueher stand hier fest verdrahtet
# eine raw.githubusercontent.com-URL im Client — die haette jede Migration nach
# GitLab ueberlebt und weiter aus GitHub gelesen.
VITE_DATA_FALLBACK_URL=""

# Zwei Eingaenge (docs/auth.md): Produktion = Microsoft-Anmeldung; die statische Demo bleibt separat erreichbar.
# VITE_DEMO_URL  -> Produktiv-Build: Link "Demo ansehen" auf der Anmeldeseite (https-URL der Demo)
# VITE_APP_URL   -> Demo-Build: Button "Mit Microsoft anmelden" fuehrt zum Produktivsystem (https-URL)
VITE_DEMO_URL=""
VITE_APP_URL=""

# ============================================
# docker compose (see docker-compose.yml)
# The app service builds DATABASE_URL from these, so setting them here is
# enough to bring the whole stack up with `docker compose up --build`.
# ============================================
MYSQL_DATABASE="bahn"
MYSQL_USER="bahn"
MYSQL_PASSWORD="bahn"
MYSQL_ROOT_PASSWORD="bahn-root"
APP_PORT=3000

# SMTP is optional by design: unset means the Anmeldung records that mail
# would have been sent and completes, rather than failing the request.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
