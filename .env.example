# ============================================
# BAHN PROJECT MANAGER v2.0 — COMPLETE ENV
# Copy to .env and fill values
# ============================================

# Database (MySQL for now — migrate to Postgres/Neon for full-text search)
DATABASE_URL="mysql://user:password@host:3306/bahn_project_manager"

# Redis (for bulletproof caching — use Upstash free tier or local)
REDIS_URL="redis://localhost:6379"          # or "rediss://user:pass@upstash.io:6379"

# Microsoft Entra ID (SSO + RBAC) — required for production
MICROSOFT_CLIENT_ID="your-client-id"
MICROSOFT_TENANT_ID="your-tenant-id"
MICROSOFT_CLIENT_SECRET="your-client-secret"
MICROSOFT_REDIRECT_URI="http://localhost:5173"   # or https://your-vercel.app

# Sentry (error monitoring — enterprise reliability)
SENTRY_DSN="https://your-sentry-dsn.ingest.sentry.io/..."

# App
NODE_ENV="development"          # production | development
PORT=3000
VITE_API_BASE_URL="http://localhost:3000"

# Optional future integrations
SHAREPOINT_SITE_URL=""
TEAMS_WEBHOOK_URL=""
POWERBI_EMBED_URL=""

# Security (optional but recommended)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ============================================
# docker compose (see docker-compose.yml)
# The app service builds DATABASE_URL from these, so setting them here is
# enough to bring the whole stack up with `docker compose up --build`.
# ============================================
MYSQL_DATABASE="bahn"
MYSQL_USER="bahn"
MYSQL_PASSWORD="bahn"
MYSQL_ROOT_PASSWORD="bahn-root"
APP_PORT=3000

# SMTP is optional by design: unset means the Anmeldung records that mail
# would have been sent and completes, rather than failing the request.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
