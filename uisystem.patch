+      const oy = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y);
+      if (ox > 2 && oy > 2) {
+        overlaps.push({
+          a: a.text.slice(0, 30),
+          b: b.text.slice(0, 30),
+          area: Math.round(ox * oy),
+          aCls: a.cls,
+          bCls: b.cls,
+        });
+      }
+    }
+  }
+
+  return {
+    spills,
+    overlaps,
+    contrast,
+    sizes: [...sizes.entries()].sort((x, y) => x[0] - y[0]),
+    weights: [...weights.entries()].sort((x, y) => y[1] - x[1]),
+    families: [...families.entries()].sort((x, y) => y[1] - x[1]),
+  };
