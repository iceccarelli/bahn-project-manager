+/* ---------------------------------------------------------------------------
+   stack-table — a data table that becomes a list on a phone.
+
+   The Fachprüfungen table is 5 columns. In a 343px dialog it needs 2.4x the
+   available width, so `overflow-x: auto` did its job and showed columns 1 and
+   2 while Prüfer, Prüfdatum and Kontakt sat off-screen behind a scroll no
+   affordance announced. Below `sm` each row becomes its own block and each
+   cell carries its column name, so all five fields are visible without any
+   horizontal scrolling at all. Above `sm` it is an ordinary table again.
+
+   The header is hidden rather than removed: it is still the accessible name
+   for every cell, and `sr-only` geometry keeps it available to a screen
+   reader while taking no space.
+   --------------------------------------------------------------------------- */
+@media (width < 40rem) {
+  .stack-table thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip-path: inset(50%);
+    white-space: nowrap;
+    border-width: 0;
+  }
+
+  .stack-table tr {
+    display: block;
+    padding: 0.75rem 0;
+  }
+
+  .stack-table td {
+    display: grid;
+    grid-template-columns: 6.5rem minmax(0, 1fr);
+    gap: 0.75rem;
+    align-items: baseline;
+    padding: 0.25rem 0.75rem;
+    border: 0;
+  }
+
+  .stack-table td::before {
+    content: attr(data-label);
+    font-size: var(--text-2xs);
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: 0.08em;
+    color: hsl(var(--muted-foreground));
+  }
+
+  /* The first cell is the row's own heading; it needs no label beside it. */
+  .stack-table td:first-child {
+    grid-template-columns: minmax(0, 1fr);
+    padding-bottom: 0.5rem;
+  }
+
+  .stack-table td:first-child::before {
+    content: none;
+  }
