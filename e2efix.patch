diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 121fe13..becc02c 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -104,6 +104,30 @@ jobs:
           vercel-project-id: ${{ secrets.VERCEL_PROJECT_ID }}
           vercel-args: '--prod'
 
+  # ---------------------------------------------------------------------------
+  # End-to-end smoke suite. Runs the production bundle in headless Chromium and
+  # asserts the flows that carry data: navigation, an edit surviving a reload
+  # and reaching the audit trail, filtering, sorting, and the wizard producing a
+  # real PDF with the corrected ITK recipients.
+  # ---------------------------------------------------------------------------
+  e2e:
+    runs-on: ubuntu-latest
+    needs: [lint-typecheck]
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: 'pnpm'
+      - run: pnpm install --frozen-lockfile
+      # Only Chromium, and only its own deps — the full `playwright install`
+      # pulls three browsers this suite never opens.
+      - run: pnpm exec playwright install --with-deps chromium
+      - run: NODE_ENV=production pnpm build:client
+      - run: pnpm e2e
+
   # ---------------------------------------------------------------------------
   # Containerisation gate. Builds the production image and proves the container
   # actually comes up and answers its own health route — a Dockerfile that
diff --git a/scripts/e2e-smoke.mjs b/scripts/e2e-smoke.mjs
index 87816ea..a31468f 100644
--- a/scripts/e2e-smoke.mjs
+++ b/scripts/e2e-smoke.mjs
@@ -35,7 +35,28 @@ const server = http.createServer((req, res) => {
 });
 await new Promise((r) => server.listen(PORT, r));
 
-const browser = await chromium.launch({ headless: true, executablePath: "/opt/pw-browsers/chromium" });
+/**
+ * Let Playwright resolve its own browser. An earlier version hardcoded
+ * /opt/pw-browsers/chromium — the path inside the machine this was written on —
+ * which meant the suite could not run anywhere else. PLAYWRIGHT_CHROMIUM_PATH
+ * is honoured for environments that ship a browser outside Playwright's cache.
+ */
+let browser;
+try {
+  browser = await chromium.launch({
+    headless: true,
+    ...(process.env.PLAYWRIGHT_CHROMIUM_PATH
+      ? { executablePath: process.env.PLAYWRIGHT_CHROMIUM_PATH }
+      : {}),
+  });
+} catch (err) {
+  console.error("!! could not launch Chromium.");
+  console.error("   Install it once with:  npx playwright install chromium");
+  console.error("   Or point at an existing binary:  PLAYWRIGHT_CHROMIUM_PATH=/path/to/chromium pnpm e2e");
+  console.error(`   (${err instanceof Error ? err.message.split("\n")[0] : err})`);
+  server.close();
+  process.exit(1);
+}
 const page = await (await browser.newContext({ viewport: { width: 1440, height: 1000 } })).newPage();
 
 let consoleErrors = [];
