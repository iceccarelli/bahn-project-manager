+    const rad = (deg: number) => (deg * Math.PI) / 180;
+    const gridHeight = rows.length * 56;
+    const sideways = Math.abs(Math.sin(rad(spin))) * gridHeight * 0.5 * zoom;
+    const rise = MAX_LIFT_PX * Math.sin(rad(tilt)) * zoom;
