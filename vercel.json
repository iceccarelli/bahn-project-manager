{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build:parallel",
  "outputDirectory": "dist/public",
  "framework": null,
  "regions": ["iad1"],
  "rewrites": [
    // OData endpoints (Microsoft-aligned queryable API)
    { "source": "/odata/(.*)", "destination": "/api/odata/$1" },
    { "source": "/api/odata/(.*)", "destination": "/api/odata/$1" },
    // API routes (Express serverless)
    { "source": "/api/(.*)", "destination": "/api/$1" },
    // SPA fallback (exclude static assets, data, odata, api)
    { "source": "/((?!data\\.json|assets/|odata/|api/|.*\\.(js|css|png|jpg|svg|ico|webmanifest)).*)", "destination": "/index.html" }
  ],
  "headers": [
    // Immutable long-term cache for static assets (perfect perf)
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    // Stale-while-revalidate for API (instant UX + fresh data)
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=60, stale-while-revalidate=300" }
      ]
    },
    // OData CORS + cache
    {
      "source": "/odata/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, OData-Version" },
        { "key": "Cache-Control", "value": "public, s-maxage=30, stale-while-revalidate=120" }
      ]
    },
    // Security headers (enterprise)
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
