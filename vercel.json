{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    // OData endpoints for perfect Microsoft-aligned queryable API (before SPA catch-all)
    { "source": "/odata/(.*)", "destination": "/api/odata/$1" },
    { "source": "/api/odata/(.*)", "destination": "/api/odata/$1" },
    // Existing SPA fallback (exclude data.json, assets, and now odata paths)
    { "source": "/((?!data\\.json|assets/|odata/|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/odata/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, OData-Version" }
      ]
    }
  ]
}
