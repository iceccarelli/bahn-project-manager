PUBLIC_HOST=staging.example.com
PUBLIC_ORIGIN=https://staging.example.com
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
JWT_SECRET=generate-with-openssl-rand-base64-48
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_AUDIENCE=<api-application-client-id>
METRICS_TOKEN=generate-with-openssl-rand-hex-24

# --- Browser sign-in (SPA app registration, "Single-page application" platform, redirect URI https://<PUBLIC_HOST>/auth/callback)
VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
VITE_OIDC_CLIENT_ID=<spa-application-client-id>
# the API scope exposed by the API app registration; its audience must equal OIDC_AUDIENCE
VITE_OIDC_SCOPE=openid profile api://<api-application-client-id>/access_as_user
